# FastAPI engine backend (../engine)
ENGINE_URL=http://localhost:8000
# Must match engine/.env's JWT_SECRET_KEY exactly — used to verify the session
# cookie locally (no network round-trip) in Next.js API routes.
JWT_SECRET_KEY=generate-a-random-secret-and-do-not-commit-the-real-one

# CSRF Protection (required)
CSRF_SECRET=your_32_character_random_string

# The one fixed LLM used for chat (no model picker, no BYOK)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Only needed if your key is identity-linked rather than workspace-scoped
ANTHROPIC_WORKSPACE_ID=

# Developer Tools (optional)
EXA_API_KEY=your_exa_api_key
GITHUB_TOKEN=your_github_token

# Production Configuration (optional)
NEXT_PUBLIC_VERCEL_URL=your_production_domain

# Development Tools (optional)
ANALYZE=false
