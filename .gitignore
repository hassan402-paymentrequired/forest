# --- OS ---
.DS_Store

# --- Python / engine ---
engine/venv/
__pycache__/
*.pyc

# Secrets — never commit; engine/.env.example is the template
engine/.env
engine/.env.local

# Generated ML artifacts — regenerate via:
#   docker compose exec api python -m app.ml.generate_synthetic
#   docker compose exec api python -m app.ml.retrain
# (see engine/README.md)
engine/training_data.csv
engine/app/models/*.pkl
engine/app/models/backups/

# Runtime file uploads (user data, not source)
engine/uploads/*
!engine/uploads/.gitkeep

# frontend/ has its own .gitignore (node_modules, .next, .env.local, etc.)
# which still applies to everything under frontend/ now that it's a normal
# tracked directory in this repo rather than a separate nested repo.
