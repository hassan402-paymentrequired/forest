DATABASE_URL=postgresql://postgres:password@localhost:5432/forest_db
JWT_SECRET_KEY=change-this-before-production

# LLM config — works with any OpenAI-compatible chat completions endpoint.
# Ollama running on the Docker host (default here, free/local):
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
# To switch to a hosted provider instead, just replace the three values above, e.g.:
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1        LLM_API_KEY=sk-...        LLM_MODEL=gpt-4o-mini
#   OpenRouter:LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_API_KEY=sk-or-...     LLM_MODEL=anthropic/claude-...
# (Running the backend outside Docker instead of via docker-compose? Use
# http://localhost:11434/v1 instead of host.docker.internal.)

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:3000

# SMTP config for forgot/reset-password emails. If SMTP_HOST is left blank,
# the reset link is logged server-side instead of emailed — so the flow is
# still fully testable before real credentials are added here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true